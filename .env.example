VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 'production' (default) or 'staging'. Controls the "STG MODE" badge on /staff.
VITE_APP_ENV=production

# Release builds also read the public switch in .env.production.
# Vercel Production must use true when the reviewed DB and Edge rollout is complete.
# Staging remains enabled; unknown Supabase projects are always refused.
VITE_CUSTOMER_ACCESS_ENABLED=true
