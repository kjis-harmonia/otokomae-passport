VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 'production' (default) or 'staging'. Controls the "STG MODE" badge on /staff.
VITE_APP_ENV=production

# Enable production Face ID/store-access UI only after the reviewed DB and Edge rollout.
# Staging remains enabled; unknown Supabase projects are always refused.
VITE_CUSTOMER_ACCESS_ENABLED=false
